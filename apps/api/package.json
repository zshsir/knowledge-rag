{
  "name": "@knowledge-rag/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:dev": "nest start --watch",
    "start:worker:dev": "ts-node src/worker.ts",
    "build": "nest build",
    "start:prod": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "tsx src/database/migrate.ts",
    "migrate:test": "cross-env DB_NAME=knowledge_rag_test tsx src/database/migrate.ts",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "pretest:e2e": "npm run migrate:test",
    "test:e2e": "cross-env DB_NAME=knowledge_rag_test NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.3.0",
    "@langchain/openai": "^1.7.0",
    "@langchain/textsplitters": "^1.0.2",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "iconv-lite": "^0.7.0",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "pg-boss": "^11.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "docx": "^9.5.1",
    "jest": "^29.7.0",
    "pdfkit": "^0.17.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.1.4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
